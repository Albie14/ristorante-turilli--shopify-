<main>
  {% render 'contact-us' %}

  <div class="container-map">
    <iframe 
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7282.241508222743!2d-68.75890115720641!3d10.336842076224805!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e80c8d4e6010e7b%3A0xb488a9d9b291c3b9!2sMcDonald&#39;s!5e0!3m2!1ses!2sve!4v1764351567092!5m2!1ses!2sve" 
      width="600" height="450" style="border:0;" 
      allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
    </iframe>
  </div>
</main>

{% stylesheet %}
  main{
    display: flex;
    justify-content: space-between;
  }

  .container-map{
    width: 49%;
    height: 100%;
    overflow: hidden;
    box-sizing: border-box;
  
  }

  .container-map iframe{
    width: 100%;
    height: 100%;
    outline: 1px solid red;
  }
{% endstylesheet %}

