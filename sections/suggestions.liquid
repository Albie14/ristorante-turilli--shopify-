<div class="suggestions">
    <div class="contactus">
        <h2>Contactanos</h2><br><br>
        <p><i class="fa-solid fa-location-dot"></i> 23 Roma Italia 75012</p><br>
        <p><i class="fa-solid fa-envelope"></i> luca@turilli.it</p><br>
        <p><i class="fa-solid fa-phone-volume"></i> +31 134-285954</p><br>
        <div class="icons-rrss">
            <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
            <a href="#"><i class="fa-brands fa-x-twitter"></i></a>
            <a href="#"><i class="fa-brands fa-instagram"></i></a>
            <a href="#"><i class="fa-brands fa-tiktok"></i></a>
        </div>
    </div>
    <div class="form-suggestions">
        <h2>Buzón de sugerencias</h2>
        {% form 'contact' %}
            <div class="group-data">
                <div class="group-input">
                    <label for="sugerencia-name"></label>
                    <input id="sugerencia-name" type="text" name="contact[name]" placeholder="Nombre (opcional)">
                </div>

                <div class="group-input">
                    <label for="suggestions-email"></label>
                    <input id="suggestions-email" type="email" name="contact[email]" placeholder="Correo" required>
                </div>
            </div>

            <div class="group-texarea">
                <label for="suggestions-msj"></label>
                <textarea id="suggestions-msj" name="contact[body]" rows="5" placeholder="Escribe aquí tu idea o comentario..." required></textarea>
            </div>

            <button type="submit" class="btn-style">Enviar sugerencia</button>
            <p>Gracias por tu sugerencia, para nosotros es importante conocerla.</p>
        {% endform %}
    </div>
</div> 

{% stylesheet %}
    .suggestions{
        display: flex;
        justify-content: space-between;
        height: 70vh;
        width: 100%;
        box-sizing: border-box;
        padding: 5% 2% 0 2%;
    }
    .suggestions h2{
        font-family: var(--font-titulo);
        font-size: 200%;
        text-align: center;
    }
    .contactus{
        width: 49%;
        height: 100%;
        background-color: var(--color-negro);
        color: var(--color-gris);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    .contactus .icons-rrss{
        width: 50%;
        height: 10%;
        display: flex;
        justify-content: space-evenly;
        
    }
    .contactus .icons-rrss a{
        font-size: 100%;
        color: var(--color-blanco);
        outline: 2px solid var(--color-blanco);
        outline-offset: 2px;
        border-radius: 15px;
        height: 30px;
        width: 30px;
        overflow: hidden;
        opacity: 0.6;
        cursor: pointer;
        transition: all ease 0.3s;
        font-size: 100%;
    }
    .contactus .icons-rrss a>i{
        display: inline-block;
        padding-left: 25%;
        padding-top: 25%;
    }
    .contactus .icons-rrss a:hover{
        opacity: 1;
        animation: expand 0.9s linear 0ms infinite normal;
        transition: all ease 0.3ms;
    }
    @keyframes expand{
        0%{outline-offset: 2px;}
        50%{outline-offset: 4px;}
        100%{outline-offset: 2px;}
    }
    .form-suggestions{
        width: 49%;
        height: 100%; 
        outline: 1px solid red;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .form-suggestions form{
        height: 85%;
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        align-items:center;
    }

    .form-suggestions form .group-data{
        display: flex;
        justify-content: space-around;
        height: 15%;
        width: 95%;
    }
    .form-suggestions form .group-data .group-input{
        width: 45%;
        outline:  1.5px solid var(--color-gris);
        border-radius: 5px;
        position: relative;
    }
    .form-suggestions form .group-data .group-input:nth-child(1):after{
        content: "Nombre";
        position: absolute;
        width: 30%;
        height: 40%;
        top: -25%;
        right: 35%;
        background-color: white;
        border-radius: 5px;
        text-align: center;
        font-size: 110%;
        font-weight: 600;
        color: var(--color-negro);
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
        opacity: 0;
        transform: translate(-20px, 20px);
        transition: opacity 0.6s ease, transform 0.6s ease;
    }

    .form-suggestions form .group-data .group-input:nth-child(1):has(input:focus)::after{
        opacity: 1;
        transform: translateY(0);
    }
    .form-suggestions form .group-data .group-input:nth-child(1):has(input:focus){
        outline:  1.5px solid var(--color-negro);
    } 

    .form-suggestions form .group-data .group-input:nth-child(2):after{
        content: "Correo";
        position: absolute;
        width: 30%;
        height: 40%;
        top: -25%;
        right: 35%;
        background-color: white;
        border-radius: 5px;
        text-align: center;
        font-size: 110%;
        font-weight: 600;
        color: var(--color-negro);
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
        opacity: 0;
        transform: translate(-20px, 20px);
        transition: opacity 0.6s ease, transform 0.6s ease;
    }

    .form-suggestions form .group-data .group-input:nth-child(2):has(input:focus)::after{
        opacity: 1;
        transform: translateY(0);
    }
    .form-suggestions form .group-data .group-input:nth-child(2):has(input:focus){
        outline:  1.5px solid var(--color-negro);
    }    
    .form-suggestions form .group-data .group-input input{
        outline: none;
        border: 1px solid var(--color-gris);
        height: 100%;
        width: 100%;
        padding-left: 5%;
    }

    .form-suggestions form .group-texarea{
        width: 90%;
        height: 40%;
        position: relative;

    }
    .form-suggestions form .group-texarea textarea{
        resize: none;
        width: 100%;
        height: 100%;
        box-sizing: border-box;
        font-family: inherit;
        overflow-y: auto;
        border:  1.5px solid var(--color-gris);
        border-radius: 5px;
        padding-left: 2%;
        padding-top: 1%;

    }
    

    .form-suggestions form .group-texarea::after{
        content: "Escribiendo";
        position: absolute;
        width: 30%;
        height: 20%;
        top: -10%;
        right: 35%;
        background-color: white;
        border-radius: 5px;
        text-align: center;
        font-size: 110%;
        font-weight: 600;
        color: var(--color-negro);
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
        opacity: 0;
        transform: translate(-10px, 10px);
        transition: opacity 0.6s ease, transform 0.6s ease;
    }
    .form-suggestions form .group-texarea:has(textarea:focus)::after{
        opacity: 1;
        transform: translate(0, 0);
    }

   
    input:focus::placeholder, textarea:focus::placeholder{
        opacity: 0;
        transition: opacity 0.3s ease;
    }

{% endstylesheet %}