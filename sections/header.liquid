<header>
  <a href="{{ routes.root_url }}" class="logo-header">
    <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" width="120" height="auto" >
  </a>
  <div class="header__menu">
    {% for link in section.settings.menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </div>

  <div class="nav__menu">
    <a href="{{ routes.root_url }}" 
        class="btn-nav {% if request.page_type == 'index' %}active{% endif %}">
      <h2>Inicio</h2>
    </a>
    <a href="{{ pages.contactanos.url }}"
        class="btn-nav {% if page.handle == 'contactanos' %}active{% endif %}">
        <h2>Contactos</h2>
      </a>
    <a href="{{ pages.menu.url }}" 
        class="btn-nav {% if page.handle == 'menu' %}active{% endif %}">
        <h2>Menu</h2>
    </a>
    <a href="{{ pages.chef.url }}" 
        class="btn-nav {% if page.handle == 'chef' %}active{% endif %}">
        <h2>Chef</h2>
      </a>
    <a href="{{  pages.usuario.url }}" 
      class="btn-nav {% if page.handle == 'usuario' %}active{% endif %}">
      <h2>Usuario</h2>
    </a>
    
  </div>
  <div class="header__icons">
    
    <button type="button" id="btn-user" class="btn-users">
        <i class="fa-solid fa-user"></i>
    </button>
    <button type="button" id="btn-cart" class="btn-users">
        <i class="fa-solid fa-cart-shopping"></i>
    </button>
    
    {% render 'sidebar' %}

  
  </div>
</header>

<script src="{{ 'sidebar.js' | asset_url}}" defer></script>

{% stylesheet %}
  header {
    height: 10rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: var(--color-negro);
    width: 100%;
    box-sizing: border-box;
    padding: 1rem 5% ;
    position: fixed;
    top: 0;
    z-index: 10;
    box-shadow: 0px 5px 9px rgba(0, 0, 0, 0.5);
    transition: height 0.1s ease;
  }
  .header-min{
    height: 5rem;
    transition: height 0.3s ease;
  }
  header .logo-header{
    height: 100%;
    width: 12%;
    display: flex;
    align-items: center;
    justify-content: center;
    /* outline: 1px solid blue; */
}

 header .logo-header img{
    border-radius: 50%;
    background-color: transparent;
    filter: brightness(1.3);
    transition: all ease 0.1s;
    scale: 1;
  }
  
  .header-min .logo-header img{
   transform: scale(0.5);
  }
  header a {
    position: relative;
    text-decoration: none;
  }
  header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }
  header svg {
    width: 2rem;
  }
  header .header__menu,
  header .header__icons {
    display: flex;
    gap: 1rem;  
  }
  .nav__menu{
    display: flex;
    justify-content: space-between;
    width: 50%;

  }
.btn-nav{
  position: relative;
  color: var(--color-blanco);
  opacity: 0.6;
  transition: all ease 0.3s;
}
.btn-nav:hover, .btn-nav.active{
  opacity: 1;
}
.btn-nav::before, .btn-nav.active::before{
  content: '';
  position: absolute;
  display: block;
  height: 1px;
  width: 0%;
  background-color: var(--color-blanco);
  top: -2px;
  left: 50%;
  transition: all ease 0.3s;
}

.btn-nav:hover::before, .btn-nav.active::before{
  width: 100%;
  left: 0;
}

.btn-nav::after, .btn-nav.active::after{
content: '';
position: absolute;
display: block;
height: 1px;
width: 0%;
background-color:var(--color-blanco);
bottom: -5px;
left: 50%;
transition: all ease 0.3s;
}

.btn-nav:hover::after, .btn-nav.active::after{
  width: 100%;
  left: 0;
}

.header__icons{
  width: 10%;
  display: flex;
  justify-content: space-evenly;
  align-items: center;
}
.btn-users{
  outline: 2px solid var(--color-blanco);
  outline-offset: 2px;
  border-radius: 15px;
  height: 30px;
  width: 30px;
  overflow: hidden;
  opacity: 0.6;
  cursor: pointer;
  transition: all ease 0.3s;
  text-align: center;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  
}
.btn-users i{
  font-size: 120%;
}
.btn-users:hover{
  opacity: 1;
  animation: expand 0.9s linear 0ms infinite normal;
  transition: all ease 0.3ms;

}
@keyframes expand{
  0%{outline-offset: 2px;}
  50%{outline-offset: 4px;}
  100%{outline-offset: 2px;}
}

.sidebar{
  position: fixed;
  top: 0;
  right: 0;
  height: 100vh;
  width:40%;
  background-color: var(--color-negro);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 3% 2%;
  box-shadow: 0 10px 10px rgba(255, 255, 255, 0.4);
  border-top-right-radius: 50px;
  transform: translateX(100%);
  transition:  transform 0.5s ease, opacity 0.5s ease;
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
}
.visible{
  transform: translateX(0);
  opacity: 1;
  pointer-events: auto;
}

.sidebar-content{
  margin-top: 5%;
  height: 100%;
  width: 100%;
  overflow: hidden;
  border: 1px solid var(--color-gris);
  border-radius: 8px;
  display: flex;
  justify-content: center;
}
.sidebar-content::-webkit-scrollbar-track{
  background-color: red;
}
.msj-cart-empty{
  height: 20rem;
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  align-items: center;
  font-size: 200%;
  color: var(--color-blanco);
}
.msj-cart-empty i{
  font-size: 300%;
}

.hidden{
  display: none;
}

{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    }
  ]
}
{% endschema %}
