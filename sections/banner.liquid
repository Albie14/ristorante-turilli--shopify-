<div class="banner">
    <div class="txt-banner">
        <h2>Comida Italiana para comenzar el dia</h2>
        <p>Empieza tu dia comiendo deliciosa comida o un cafe <span>Italiano</span></p>
        <a href="#" class="btn-style">Ordenar Ahora</a>
    </div>
</div>

{% stylesheet %}

.banner{
    margin-top: 2rem;
    width: 100%;
    height: 60vh;
    background-image: 
        linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
        url("/assets/ensalada.webp");
    background-repeat: no-repeat;
    background-size: cover;
    background-clip: content-box;
    color: var(--color-blanco);
    display: flex;
    align-items: center;
    box-sizing: border-box;
}
.txt-banner{
    margin-left: 5%;
    height: 60%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
}

.txt-banner h2{
    font-family: var(--font-titulo);
    font-size: 300%;
}

.txt-banner p{
    font-size: 150%;
}
.txt-banner span{
    font-style: oblique;
    font-weight: 600;
}
.txt-banner a{
    text-decoration: none;
    height: 20%;
    width: 30%;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
}
{% endstylesheet %}