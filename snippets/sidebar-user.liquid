<div class="sidebar-user">
    <div class="form-login">
        {% form 'customer_login'  %}
            <div class="group-input-login">
                <label for="email-login"></label>
                <input type="email" name="customer[email]" id="email-login" placeholder="Correo" required>
            </div>
            <div class="group-input-login">
                <label for="password-login"></label>
                <input type="password" name="customer[password]" id="password-login" placeholder="Clave" required>
                <i class="fa-solid fa-eye"></i>
            </div>
            <button type="submit" class="btn-login btn-nav">Ingresar</button>
            <p class="msj-error">Dato errado o incompleto</p>
        {% endform %}
    </div>
    {% comment %} <div class="form-register">
        {% form 'create_customer' %}
            <div class="group-register">
                <div class="group-input-register">
                    <label for="name-register"></label>
                    <input type="text" name="customer[first_name]" id="name-register" placeholder="Nombre" required>
                </div>
                <div class="group-input-register">
                    <label for="last-name-register"></label>
                    <input type="text" name="customer[last_name]" id="last-name-register" placeholder="Apellido" required>
                </div>
            </div>
            <div class="group-register">
                <div class="group-input-register">
                    <label for="email-register"></label>
                    <input type="email" name="customer[email]" id="email-register" placeholder="Correo" required>
                </div>
                <div class="group-input-register">
                    <label for="password-register"></label>
                    <input type="password" name="customer[password]" id="password-register" placeholder="Clave" required>
                    <i class="fa-solid fa-eye"></i>
                </div>
            </div>
            <button type="submit" class="btn-register btn-nav">Registrarse</button>
            <p class="msj-error">Todos los campos son obligatorios</p>
        {% endform %}
    </div> {% endcomment %}
</div>

{% style %}

.sidebar-user{
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    align-items: center;
    box-sizing: border-box;
    height: 100%;
    border-radius: 8px;
}
.form-login, 
.form-register{
    width: 95%;
    height: 12rem;
    box-shadow: inset 0 0 5px rgba(255, 255, 255, 0.8);
    border-radius: 8px;
}
.form-login form,
.form-register form{          
    height: 100%;
    box-sizing: border-box;
    padding-top: 2% ;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
}
.group-input-login{
    height: 25%;
    width: 90%;
    position: relative;
}
.group-input-login i,
.group-input-register i{
    position: absolute;
    right: 5%;
    top:30%;   
    transition: all 0.2s ease;
    color: var(--color-gris);
    cursor: pointer;
}
.group-input-login:has(input:focus) i,
.group-input-login:has(input:valid) i,
.group-input-register:has(input:focus) i,
.group-input-register:has(input:valid) i{
    color: var(--color-blanco);
    transition: all 0.2s ease;
}

.group-input-login input,
.group-input-register input{
    outline:none;
    width: 100%;
    height: 100%;
    border: 1px solid var(--color-gris);
    border-radius: 8px;
    background: none;
    color: var(--color-blanco);
    padding-left: 5%;
    text-transform: lowercase;
}
.group-input-login input:focus,
.group-input-register input:focus{
    border: 2.5px solid var(--color-gris);
}

.group-input-login input:focus::placeholder, 
.group-input-register input:focus::placeholder{
    color: transparent;
}
.group-input-login:not(:placeholder-shown),
.group-input-register:not(:placeholder-shown){
    border: 2.5px solid var(--color-verder);
}
.group-input-login input::placeholder,
.group-input-register input::placeholder{
    font-size: 120%;
    padding-left: 10%;
    font-weight: 700;
    letter-spacing: 2px;
}
.btn-login, .btn-register{
    margin-top: 0.5rem;
    height: 20%;
    width: 30%;
    background-color: transparent;
    cursor: pointer;
    border: none;
    font-family: 'Mulish', sans-serif;
    font-size: 120%;
    font-weight: 600;
}

.msj-error{
    color: red;
    text-shadow: 0 2px 5px rgba(248, 6, 6, 0.8);
    font-size: 80%;
    letter-spacing: 0.5px;
    opacity: 0;
    transition: opacity ease 0.2s;
}
.group-register{
    display: flex;
    height: 30%;
}

.group-register{
    display: flex;
    justify-content: space-between;
    width: 90%;
}
.group-input-register{
    height: 70%;
    width: 49%;
    position: relative;
}

{% endstyle %}
